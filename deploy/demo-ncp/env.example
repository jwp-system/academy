# /srv/academy/.env (데모 서버). chmod 600
# 데모판은 문자·메일을 절대 실제로 보내지 않고, 입금 웹훅도 없어서 게이트웨이·메일 설정이 필요 없다.
ACADEMY_ACADEMY_NAME=OO학원
ACADEMY_SECRET_KEY=          # python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ACADEMY_COOKIE_SECURE=true
# 데모 DB는 이 값으로만 정한다 (ACADEMY_DATABASE_URL은 무시됨). 파일 이름은 demo로 시작해야 초기화된다.
DEMO_DATABASE_URL=sqlite:////srv/academy/data/demo.db
