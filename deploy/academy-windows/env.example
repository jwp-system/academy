# C:\Academy\.env (학원 PC). 다른 사람이 볼 수 없는 곳에 두고 저장소에 커밋하지 않는다.
ACADEMY_ACADEMY_NAME=OO학원
ACADEMY_SECRET_KEY=          # python -c "import secrets; print(secrets.token_urlsafe(32))"
ACADEMY_COOKIE_SECURE=true   # Cloudflare Tunnel(https) 주소로만 접속하므로 true

# 문자: 같은 와이파이의 게이트웨이 폰 (로컬 서버 모드). 공유기에서 폰 IP를 고정해 두기
ACADEMY_SMS_MODE=auto
ACADEMY_SMS_GATEWAY_URL=http://192.168.0.50:8080
ACADEMY_SMS_GATEWAY_USER=        # 게이트웨이 앱 → Local Server 화면의 아이디
ACADEMY_SMS_GATEWAY_PASSWORD=    # 같은 화면의 비밀번호

# 입금 문자 웹훅
ACADEMY_SMS_WEBHOOK_SIGNING_KEY= # 게이트웨이 앱 → Settings → Webhooks → Signing Key
ACADEMY_BANK_SENDER_NUMBERS=     # 은행 입금 알림 발신번호 (쉼표 구분)
ACADEMY_BANK_ACCOUNT=            # 청구 안내에 넣을 계좌 (예: OO은행 123-456-789 홍길동)

# 이메일 (Gmail 앱 비밀번호, 게이트웨이 장애 알림·청구 안내 메일)
ACADEMY_EMAIL_MODE=auto
ACADEMY_SMTP_USER=
ACADEMY_SMTP_PASSWORD=

# 자동 백업: 매일 02:30. OneDrive·구글 드라이브 동기화 폴더로 지정하면 클라우드에도 사본이 남는다
ACADEMY_BACKUP_DIR=C:\Users\사용자\OneDrive\학원백업
ACADEMY_BACKUP_KEEP_DAYS=30
