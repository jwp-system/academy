# cp .env.example .env 후 값 채우기 (.env는 커밋하지 않음)
ACADEMY_ACADEMY_NAME=OO학원
ACADEMY_SECRET_KEY=   # python -c "import secrets; print(secrets.token_urlsafe(32))"
ACADEMY_COOKIE_SECURE=false   # Cloudflare Tunnel(HTTPS) 배포 시 true
# ACADEMY_DATABASE_URL=sqlite:////home/.../academy/data/academy.db

# 발송 모드: auto(접속 정보가 있으면 실제 발송, 없으면 테스트 수신함) | live | test
ACADEMY_SMS_MODE=auto
ACADEMY_EMAIL_MODE=auto

# SMS Gateway for Android (앱의 Local Server 화면 값)
ACADEMY_SMS_GATEWAY_URL=http://192.168.0.10:8080
ACADEMY_SMS_GATEWAY_USER=
ACADEMY_SMS_GATEWAY_PASSWORD=
ACADEMY_SMS_WEBHOOK_SIGNING_KEY=   # 게이트웨이 앱 Settings → Webhooks → Signing Key (권장)
ACADEMY_SMS_WEBHOOK_TOKEN=   # 서명 키 대신 웹훅 URL에 ?token=값 을 붙이는 방식
ACADEMY_BANK_SENDER_NUMBERS=   # 은행 입금 알림 발신번호, 쉼표 구분

# Gmail SMTP
ACADEMY_SMTP_USER=
ACADEMY_SMTP_PASSWORD=

# 청구 안내 문자에 넣을 입금 계좌
ACADEMY_BANK_ACCOUNT=   # 예: OO은행 123-456-789 홍길동

# 자동 백업 (구축판): 매일 02:30. 비우면 data/backups
# ACADEMY_BACKUP_DIR=
ACADEMY_BACKUP_KEEP_DAYS=30

# 데모판 DB (demo 명령만 사용. ACADEMY_DATABASE_URL과 따로)
# DEMO_DATABASE_URL=sqlite:////.../data/demo.db
