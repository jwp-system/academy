# cp .env.example .env 후 값 채우기 (.env는 커밋하지 않음)
ACADEMY_ACADEMY_NAME=OO학원
ACADEMY_SECRET_KEY=   # python -c "import secrets; print(secrets.token_urlsafe(32))"
ACADEMY_COOKIE_SECURE=false   # Cloudflare Tunnel(HTTPS) 배포 시 true
# ACADEMY_DATABASE_URL=sqlite:////home/.../academy/data/academy.db

# SMS Gateway for Android
ACADEMY_SMS_GATEWAY_URL=http://192.168.0.10:8080
ACADEMY_SMS_GATEWAY_USER=
ACADEMY_SMS_GATEWAY_PASSWORD=
ACADEMY_SMS_WEBHOOK_TOKEN=
ACADEMY_BANK_SENDER_NUMBERS=   # 은행 입금 알림 발신번호, 쉼표 구분

# Gmail SMTP
ACADEMY_SMTP_USER=
ACADEMY_SMTP_PASSWORD=
